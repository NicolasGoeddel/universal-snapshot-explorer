{% from 'snapshots_bar.svg.j2' import render_snapshot_bar %}
{% from 'criteria_dropdown.html.j2' import snapshot_criteria_dropdown %}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
    {% include 'header.html.j2' %}
    <link rel="stylesheet" href="{{ static_url('css/file_browser.css') }}">
    <link rel="stylesheet" href="{{ static_url('css/criteria_manager.css') }}">
    <link rel="stylesheet" href="{{ static_url('css/column_visibility.css') }}">
    <script src="{{ static_url('js/criteria_manager.js') }}" defer></script>
    <script src="{{ static_url('js/filter_strategies.js') }}" defer></script>
    <script src="{{ static_url('js/column_visibility.js') }}" defer></script>
    <script src="{{ static_url('js/explorer.js') }}" defer></script>
</head>
<body>
    <div class="sticky-header-container">
        <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px;">
            <h2 style="display: flex; align-items: center; gap: 8px; margin: 0;">{{ lucide('folder-tree', size=24) }} {{ t('index.title') }}</h2>
            {% include 'global_controls.html.j2' %}
        </div>
        {% include 'breadcrumbs.html.j2' %}
        <div class="explorer-toolbar" role="toolbar">
            <label class="toolbar-item toolbar-toggle" title="{{ t('filter.hidden_files_title') }}">
                <input type="checkbox" id="toggle-hidden">
                {{ lucide('eye-off', size=15, class_='toolbar-toggle-icon') }}
                <span>{{ t('filter.hidden_files') }}</span>
                <span class="toggle-badge" id="badge-hidden-count" style="display: none;">0</span>
            </label>
            <label class="toolbar-item toolbar-toggle" title="{{ t('filter.missing_files_title') }}">
                <input type="checkbox" id="toggle-missing" checked>
                {{ lucide('ghost', size=15, class_='toolbar-toggle-icon') }}
                <span>{{ t('filter.missing_files') }}</span>
                <span class="toggle-badge" id="badge-missing-count" style="display: none;">0</span>
            </label>
            <label class="toolbar-item toolbar-toggle" title="{{ t('filter.changed_only_title') }}">
                <input type="checkbox" id="toggle-changed">
                {{ lucide('history', size=15, class_='toolbar-toggle-icon') }}
                <span>{{ t('filter.changed_only') }}</span>
                <span class="toggle-badge" id="badge-changed-count" style="display: none;">0</span>
            </label>
            <span class="toolbar-divider" aria-hidden="true"></span>
            {{ snapshot_criteria_dropdown('snapshot', t) }}
            <div class="dropdown col-visibility-dropdown">
                <button type="button" class="col-visibility-toolbar-btn" id="btn-column-visibility" title="{{ t('columns.toolbar_button') }}">
                    {{ lucide('columns-3', size=15, class_='text-muted') }}
                    <span>{{ t('columns.toolbar_button') }}</span>
                    {{ lucide('chevron-down', size=13, class_='text-muted') }}
                </button>
                <div class="dropdown-content col-visibility-menu" id="col-visibility-panel"></div>
            </div>
            <div class="toolbar-stats" id="toolbar-stats"></div>
        </div>
    </div>

    <div id="snapshot-loading-overlay" class="snapshot-loading-overlay is-visible" aria-live="polite">
        <div class="snapshot-loading-card">
            <div class="snapshot-loading-spinner-wrapper">
                <div class="snapshot-loading-conic-ring"></div>
                <div class="snapshot-loading-inner-icon">
                    {{ lucide('hourglass', size=18) }}
                </div>
            </div>
            <span class="snapshot-loading-text">{{ t('loading.snapshots') }}</span>
        </div>
    </div>

    <table id="filebrowser" class="filebrowser is-loading-snapshots" data-root="{{ root_name }}" data-snapshot="{{ folder.snapshot.id }}" data-subpath="{{ directory_path }}" data-resizer-tooltip="{{ t('table.resizer_tooltip') }}" data-loading-text="{{ t('loading.snapshots') }}">
        <thead>
            <tr class="header-row">
                <th class="browser-header-select" data-fixed-width="32" style="width: 32px; min-width: 32px; max-width: 32px; text-align: center; padding: 2px 4px;">
                    <input type="checkbox" id="master-select-checkbox" class="custom-checkbox" title="{{ t('selection.select_all_visible') }}">
                </th>
                <th class="browser-header-name sortable" data-sort-type="text" data-col-key="name" data-elastic="true" data-default-pct="28" data-min-width="45">{{ t('table.name') }}</th>
                <th class="browser-header-snapshots sortable" data-sort-type="snapshot-bar" data-default-dir="desc" data-col-key="snapshots" data-ignore-content="true" data-default-pct="27" data-min-width="120" data-soft-min="160">
                    {{ t('table.snapshots') }}
                    <span class="col-help" title="{{ t('table.snapshots_help') }}">{{ lucide('circle-question-mark', size=13) }}</span>
                </th>
                <th class="browser-header-size sortable" data-sort-type="number" data-col-key="size" data-default-pct="8" data-min-width="50">{{ t('table.size') }}</th>
                <th class="browser-header-type sortable" data-sort-type="text" data-col-key="type" data-default-pct="9" data-min-width="45">{{ t('table.type') }}</th>
                <th class="browser-header-owner sortable" data-sort-type="text" data-col-key="user" data-default-pct="8.5" data-min-width="45">{{ t('table.user') }}</th>
                <th class="browser-header-mode sortable" data-sort-type="octal" data-col-key="mode" data-default-pct="7" data-min-width="55">Mode</th>
                <th class="browser-header-mtime sortable" data-sort-type="date" data-col-key="mtime" data-default-pct="10.5" data-min-width="45">{{ t('table.modified') }}</th>
                <th class="browser-header-ctime sortable" data-sort-type="date" data-col-key="ctime" data-default-pct="12" data-min-width="45">{{ t('table.changed') }}</th>
                <th class="browser-header-actions" data-fixed-width="84" style="width: 84px; min-width: 84px; max-width: 84px;">
                    <div class="browser-cell-actions-wrapper">
                        <a href="{{ base_url }}/detail/{{ root_name | quote_plus }}/{{ directory_path | quote_path }}?snapshot={{ folder.snapshot.id | quote_plus }}" title="{{ t('action.show_folder_details') }}" class="action-btn action-info">{{ lucide('info', size=16) }}</a>
                    </div>
                </th>
            </tr>
            <tr class="column-filter">
                <td class="browser-filter-select">
                    <button type="button" class="invert-selection-btn" id="btn-invert-selection" title="{{ t('selection.invert') }}" aria-label="{{ t('selection.invert') }}">{{ lucide('replace', size=14) }}</button>
                </td>
                <td>
                    <div class="filter-input-wrapper">
                        <input type="text" placeholder="{{ t('filter.search_placeholder') }}" data-col="1" data-filter-type="text">
                        <span class="filter-badge" style="display: none;"></span>
                        <button type="button" class="filter-clear-btn" style="display: none;" title="{{ t('filter.clear') }}">&times;</button>
                    </div>
                </td>
                <td class="browser-filter-snapshots">
                    <div class="snapshots-header-timeline">
                        {{ render_snapshot_bar(folder.snapshots_bar, current_snapshot_id=folder.snapshot.id, is_header=true, with_links=true, root_name=root_name, path=directory_path, module='list', t=t) }}
                    </div>
                </td>
                <td>
                    <div class="filter-input-wrapper">
                        <input type="text" placeholder="{{ t('filter.search_placeholder') }}" data-col="3" data-filter-type="size">
                        <span class="filter-badge" style="display: none;"></span>
                        <button type="button" class="filter-clear-btn" style="display: none;" title="{{ t('filter.clear') }}">&times;</button>
                    </div>
                </td>
                <td>
                    <div class="filter-input-wrapper">
                        <input type="text" placeholder="{{ t('filter.search_placeholder') }}" data-col="4" data-filter-type="text">
                        <span class="filter-badge" style="display: none;"></span>
                        <button type="button" class="filter-clear-btn" style="display: none;" title="{{ t('filter.clear') }}">&times;</button>
                    </div>
                </td>
                <td>
                    <div class="filter-input-wrapper">
                        <input type="text" placeholder="{{ t('filter.search_placeholder') }}" data-col="5" data-filter-type="text">
                        <span class="filter-badge" style="display: none;"></span>
                        <button type="button" class="filter-clear-btn" style="display: none;" title="{{ t('filter.clear') }}">&times;</button>
                    </div>
                </td>
                <td>
                    <div class="filter-input-wrapper">
                        <input type="text" placeholder="{{ t('filter.search_placeholder') }}" data-col="6" data-filter-type="mode">
                        <span class="filter-badge" style="display: none;"></span>
                        <button type="button" class="filter-clear-btn" style="display: none;" title="{{ t('filter.clear') }}">&times;</button>
                    </div>
                </td>
                <td>
                    <div class="filter-input-wrapper">
                        <input type="text" placeholder="{{ t('filter.search_placeholder') }}" data-col="7" data-filter-type="date">
                        <span class="filter-badge" style="display: none;"></span>
                        <button type="button" class="filter-clear-btn" style="display: none;" title="{{ t('filter.clear') }}">&times;</button>
                    </div>
                </td>
                <td>
                    <div class="filter-input-wrapper">
                        <input type="text" placeholder="{{ t('filter.search_placeholder') }}" data-col="8" data-filter-type="date">
                        <span class="filter-badge" style="display: none;"></span>
                        <button type="button" class="filter-clear-btn" style="display: none;" title="{{ t('filter.clear') }}">&times;</button>
                    </div>
                </td>
                <td></td>
            </tr>
        </thead>
        <tbody>
            {% include 'folder_content.html.j2' %}
        </tbody>
    </table>

    <!-- Floating Action Bar for Multi-Selection & ZIP Batch-Download -->
    <div id="floating-action-bar" class="floating-action-bar" style="display: none;">
        <div class="action-bar-content">
            <div class="action-bar-info">
                <span class="action-bar-counter" id="selection-counter">{{ t('selection.selected_count', count=0) }}</span>
                <span class="action-bar-breakdown" id="selection-breakdown" style="display: none;"></span>
                <span class="action-bar-warning" id="selection-warning" style="display: none;"></span>
            </div>
            <div class="action-bar-controls">
                <div class="action-bar-action-wrapper" id="action-select-wrapper" style="display: none;">
                    <label for="selection-action-select" class="action-bar-label">{{ t('selection.action') }}:</label>
                    <select id="selection-action-select" class="action-bar-select"></select>
                </div>
                <div class="action-bar-options-wrapper" id="action-options-wrapper" style="display: none;">
                    <label for="selection-option-select" id="action-option-label" class="action-bar-label"></label>
                    <select id="selection-option-select" class="action-bar-select"></select>
                </div>
                <button type="button" id="btn-execute-action" class="action-bar-btn primary">
                    <span id="btn-execute-label">{{ t('selection.download_zip') }}</span>
                </button>
                <button type="button" id="btn-clear-selection" class="action-bar-btn secondary" title="{{ t('selection.clear') }} (Esc)">
                    {{ lucide('x', size=15) }} <span>{{ t('selection.clear') }}</span> <kbd class="action-kbd-hint">Esc</kbd>
                </button>
            </div>
        </div>
    </div>
    <template id="folder-toggle-template"><span class="folder-toggle icon" title="Toggle folder">{{ lucide('chevron-right', size=14) }}</span></template>
</body>
</html>
