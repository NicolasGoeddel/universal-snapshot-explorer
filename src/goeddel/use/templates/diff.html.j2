{% from 'criteria_dropdown.html.j2' import snapshot_criteria_dropdown %}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
    {% include 'header.html.j2' %}
    <link rel="stylesheet" href="{{ static_url('css/criteria_manager.css') }}">
    <link rel="stylesheet" href="{{ static_url('css/differ.css') }}">
    <link rel="stylesheet" href="{{ static_url('css/pygments.css') }}">
    <script src="{{ static_url('js/criteria_manager.js') }}" defer></script>
    <script src="{{ static_url('js/differ.js') }}" defer></script>
    <script src="{{ static_url('js/plugins/text_differ.js') }}" defer></script>
</head>
<body class="differ-view">
    <div class="sticky-header-container">
        <div class="differ-title-row">
            <h2 style="display: flex; align-items: center; gap: 8px;">
                {{ lucide('file-diff', size=24) }}
                <span class="differ-file-name">{{ file.name if file.name else root_name }}</span>
            </h2>
            <div class="differ-header-actions">
                <a class="differ-action-btn" href="{{ route_url('detail', root_name, file.path, right_snapshot_id) }}" title="{{ t('action.show_details') }}">
                    {{ lucide('info', size=14) }} {{ t('action.details') }}
                </a>
                <a class="differ-action-btn" href="{{ route_url('list', root_name, file.parent_path, right_snapshot_id) }}#{{ file.name | quote_plus }}" title="{{ t('action.open_explorer') }}">
                    {{ lucide('external-link', size=14) }} Explorer
                </a>
            </div>
        </div>

        <div style="margin-bottom: 4px;">
            {% include 'global_controls.html.j2' %}
        </div>

        {% include 'breadcrumbs.html.j2' %}

        <!-- Differ Toolbar -->
        <div class="differ-toolbar" id="differ-toolbar"
             data-root="{{ root_name }}"
             data-path="{{ file.path }}"
             data-initial-snapshots="{{ initial_snapshots }}">

            <!-- Panel 1: Snapshot Selection (timeline + which snapshots are being compared) -->
            <div class="differ-panel-selection">
            <div class="differ-timeline-container">
                <div class="differ-timeline-header-group">
                    <span class="timeline-title">{{ lucide('history', size=15) }} {{ t('diff.timeline_title') }}</span>
                    <div class="differ-timeline-header-actions">
                        {{ snapshot_criteria_dropdown('diff', t, icon_size=14) }}
                        <label class="differ-toggle-label differ-hide-toggle" title="{{ t('diff.hide_unchanged_hint') }}">
                            <input type="checkbox" id="diff-hide-unchanged-check" checked>
                            <span>{{ t('diff.hide_unchanged') }}</span>
                        </label>
                    </div>
                </div>
                <span class="timeline-hint">{{ t('diff.timeline_hint') }}</span>
                <div class="differ-timeline-bar-wrapper" id="diff-timeline-wrapper">
                    {%- set bar_items = snapshots_bar | default([]) | list -%}
                    {%- set bar_count = bar_items | length -%}
                    {%- set cell_w = 20 -%}
                    {%- set total_w = bar_count * cell_w -%}
                    {#- Same bounded-width approach as the browser's snapshot bars: pills
                        stay close to square, grow a little when there are few snapshots,
                        and squish (rather than stretch into blobs) when there are many. -#}
                    {%- set min_cell = 8 -%}
                    {%- set max_cell = 28 -%}
                    <svg id="diff-timeline-svg" class="diff-timeline-svg" viewBox="-1 -6 {{ total_w + 2 }} 34" preserveAspectRatio="none" style="width: 100%; min-width: {{ bar_count * min_cell }}px; max-width: {{ bar_count * max_cell }}px; height: 32px;">
                        <!-- Active Pair Bracket -->
                        <g id="active-pair-bracket-group">
                            <path id="active-pair-bracket" class="bracket-path" d="" />
                        </g>

                        <g id="diff-timeline-segments">
                            {% include 'diff_timeline_segments.html.j2' %}
                        </g>
                    </svg>
                </div>
            </div>

            <!-- Older/newer legend flanks the stepper so its own row always has
                 context, instead of a small button cluster floating by itself; it
                 also answers "which side of the timeline is more recent" directly,
                 since the bracket alone doesn't say. -->
            <div class="differ-timeline-footer-row">
                <span class="timeline-edge-legend">{{ lucide('arrow-left', size=13) }} {{ t('diff.older') }}</span>
                <div class="differ-stepper-container" id="diff-stepper" style="display: none;">
                    <button type="button" class="differ-btn stepper-btn" id="stepper-prev" title="{{ t('diff.prev_transition') }}">
                        {{ lucide('chevron-left', size=16) }}
                    </button>
                    <div class="stepper-info">
                        <span class="stepper-label" id="stepper-label">1 / 1</span>
                    </div>
                    <button type="button" class="differ-btn stepper-btn" id="stepper-next" title="{{ t('diff.next_transition') }}">
                        {{ lucide('chevron-right', size=16) }}
                    </button>

                    <!-- Group Size Input for Multi-Snapshot Navigation -->
                    <input type="number" id="differ-group-size" class="differ-group-size-input" min="2" style="display: none;" title="Group Size">
                </div>
                <span class="timeline-edge-legend">{{ t('diff.newer') }} {{ lucide('arrow-right', size=13) }}</span>
            </div>
            </div>
        </div>
    </div>

    <!-- Main Diff Viewport -->
    <main class="differ-main-content" id="differ-main-content">
        <!-- Diff Display Settings: how the comparison is rendered, kept attached to the
             view it controls instead of living in the snapshot-selection toolbar above. -->
        <div class="differ-display-settings-bar" id="differ-display-settings-bar">
            <!-- Plugin Controls Slot (Stats, Mode toggles, Wrap, Collapse) -->
            <div class="differ-plugin-controls" id="differ-plugin-controls"></div>

            <!-- Differ Plugin Selector Dropdown -->
            <div class="differ-plugin-selector-wrap">
                <select class="differ-select" id="differ-plugin-selector" title="{{ t('diff.select_plugin') }}" aria-label="{{ t('diff.select_plugin') }}">
                    <option value="text-differ">Text Differ</option>
                </select>
            </div>
        </div>
        <div id="diff-loading" class="diff-loading-indicator" style="display: none;">
            <span class="diff-spinner"></span>
            <span>{{ t('diff.loading') }}</span>
        </div>
        <div id="diff-viewport" class="diff-viewport"></div>
    </main>
</body>
</html>
