{%- macro pill_path(x, y, w, h, r, round_left, round_right) -%}
{%- set x0 = x -%}
{%- set x1 = x + w -%}
{%- set y0 = y -%}
{%- set y1 = y + h -%}
{%- if round_left and round_right -%}
M {{ x0 + r }} {{ y0 }} H {{ x1 - r }} A {{ r }} {{ r }} 0 0 1 {{ x1 }} {{ y0 + r }} V {{ y1 - r }} A {{ r }} {{ r }} 0 0 1 {{ x1 - r }} {{ y1 }} H {{ x0 + r }} A {{ r }} {{ r }} 0 0 1 {{ x0 }} {{ y1 - r }} V {{ y0 + r }} A {{ r }} {{ r }} 0 0 1 {{ x0 + r }} {{ y0 }} Z
{%- elif round_left and not round_right -%}
M {{ x0 + r }} {{ y0 }} H {{ x1 }} V {{ y1 }} H {{ x0 + r }} A {{ r }} {{ r }} 0 0 1 {{ x0 }} {{ y1 - r }} V {{ y0 + r }} A {{ r }} {{ r }} 0 0 1 {{ x0 + r }} {{ y0 }} Z
{%- elif not round_left and round_right -%}
M {{ x0 }} {{ y0 }} H {{ x1 - r }} A {{ r }} {{ r }} 0 0 1 {{ x1 }} {{ y0 + r }} V {{ y1 - r }} A {{ r }} {{ r }} 0 0 1 {{ x1 - r }} {{ y1 }} H {{ x0 }} Z
{%- else -%}
M {{ x0 }} {{ y0 }} H {{ x1 }} V {{ y1 }} H {{ x0 }} Z
{%- endif -%}
{%- endmacro -%}

{%- macro render_snapshot_bar(items, current_snapshot_id=none, is_header=false, is_sub_dataset=false, with_links=false, root_name='', path='', module='list') -%}
{%- set bar_items = items | default([]) | list -%}
{%- set bar_count = bar_items | length -%}
{%- set cell_w = 20 -%}
{%- set seg_w = 19 -%}
{%- set seg_h = 15 if is_header else 18 -%}
{%- set corner_r = 5 if is_header else 6 -%}
{%- set view_h = 18 if is_header else 21 -%}
{%- set circle_cy = 8.5 if is_header else 10 -%}
{%- set circle_r = 3.5 if (is_header or with_links) else 4 -%}
{%- set total_w = bar_count * cell_w -%}
<svg class="snapshotbar{{ ' header-snapshotbar' if is_header else '' }}{{ ' is-sub-dataset' if is_sub_dataset else '' }}" viewBox="-1 -1 {{ total_w + 2 }} {{ view_h }}" preserveAspectRatio="none" style="width: 100%; max-width: {{ total_w }}px;{% if not is_header %} height: 100%;{% endif %}">
    {%- for item in bar_items %}
        {%- set snap = item.snapshot -%}
        {%- set x = loop.index0 * cell_w -%}
        {%- set is_current = (current_snapshot_id is not none and snap and snap.id == current_snapshot_id) -%}
        {%- set prev_item = bar_items[loop.index0 - 1] if loop.index0 > 0 else none -%}
        {%- set next_item = bar_items[loop.index0 + 1] if loop.index0 < bar_count - 1 else none -%}
        {%- set round_left = (prev_item is none or prev_item.color != item.color or prev_item.missing != item.missing) -%}
        {%- set round_right = (next_item is none or next_item.color != item.color or next_item.missing != item.missing) -%}
        {%- set d = pill_path(x + 0.5, 1, seg_w, seg_h, corner_r, round_left, round_right) -%}
        {%- set fill_color = "var(--snap-missing)" if (item.missing or item.color is none) else (item.color if (item.color is string and item.color.startswith("var(")) else "var(--snap-" ~ item.color ~ ")") -%}
        {%- if with_links and snap %}
        <a href="{{ route_url(module, root_name, path, snap.id) }}"
           data-snap-id="{{ snap.id }}"
           data-snap-name="{{ snap.name }}"
           data-snap-time="{{ snap.timestamp_formatted if snap.timestamp_formatted else '' }}"
           data-is-current="{{ 'true' if is_current else 'false' }}"
           data-is-missing="{{ 'true' if item.missing else 'false' }}">
        {%- endif %}
        {%- if item.missing %}
            <path d="{{ d }}" fill="{{ fill_color }}" stroke="rgba(0,0,0,0.25)" stroke-width="1" class="{% if is_header or with_links %}header-snap-rect {{ 'current-snapshot-rect' if is_current else '' }}{% endif %}"/>
            <line x1="{{ x + 3 }}" y1="{{ 2.5 if is_header else 3.5 }}" x2="{{ x + 16.5 }}" y2="{{ 13.5 if is_header else 16.5 }}" stroke="#ef4444" stroke-width="1.5"/>
            <line x1="{{ x + 16.5 }}" y1="{{ 2.5 if is_header else 3.5 }}" x2="{{ x + 3 }}" y2="{{ 13.5 if is_header else 16.5 }}" stroke="#ef4444" stroke-width="1.5"/>
        {%- else %}
            <path d="{{ d }}" fill="{{ fill_color }}" stroke="{% if is_header or with_links %}rgba(0,0,0,0.15){% else %}rgba(0,0,0,0.12){% endif %}" stroke-width="1" class="{% if is_header or with_links %}header-snap-rect {{ 'current-snapshot-rect' if is_current else '' }}{% endif %}"/>
        {%- endif -%}
        {%- if is_current %}
            <circle cx="{{ x + 10 }}" cy="{{ circle_cy }}" r="{{ circle_r }}" fill="#ffffff" stroke="#1e293b" stroke-width="1.5"></circle>
        {%- endif %}
        {%- if with_links and snap %}
        </a>
        {%- endif %}
    {%- endfor -%}
</svg>
{%- endmacro -%}

{%- macro snapshots_bar(entry, base_url, module, root_name, folder) -%}
{%- set current_snap_id = entry.snapshot.id if not entry.is_sub_dataset else none -%}
{{ render_snapshot_bar(entry.snapshots_bar, current_snapshot_id=current_snap_id, is_header=false, is_sub_dataset=entry.is_sub_dataset, with_links=false) }}
{%- endmacro -%}

{%- macro snapshots_bar_skeleton(snapshots_count) -%}
{%- set bar_width = 20 -%}
{%- set count = snapshots_count | default(10) -%}
{%- if count < 1 -%}{%- set count = 10 -%}{%- endif -%}
<svg class="snapshotbar snapshot-skeleton-svg" viewBox="-1 -1 {{ count * bar_width + 2 }} 21" preserveAspectRatio="none" style="width: 100%; max-width: {{ count * bar_width }}px; height: 100%;">
    {%- for i in range(count) %}
    {%- set d = pill_path(i * bar_width + 0.5, 1, 19, 18, 6, i == 0, i == count - 1) -%}
    <path d="{{ d }}" class="skeleton-rect" style="animation-delay: {{ (i * 0.04) | round(2) }}s;"/>
    {%- endfor %}
</svg>
{%- endmacro -%}