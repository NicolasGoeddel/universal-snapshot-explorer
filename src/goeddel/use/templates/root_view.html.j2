<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
    {% include 'header.html.j2' %}
    <link rel="stylesheet" href="{{ static_url('css/root_view.css') }}">
    <script src="{{ static_url('js/root_view.js') }}" defer></script>
    
</head>
<body>
    <div class="root-list-container">
        <div class="root-header-sticky-container">
            <div class="root-header-bar">
                <h2 style="display: flex; align-items: center; gap: 10px; margin: 0;">
                    {{ lucide('hard-drive', size=26) }} {{ t('index.title') }}
                </h2>
                {% include 'nav_controls.html.j2' %}
            </div>
            <p style="color: var(--text-muted); margin: 0 0 6px 0; font-size: 9.5pt;">{{ t('index.prompt') }}</p>
        </div>
        
        <table id="rootbrowser" class="filebrowser" data-resizer-tooltip="{{ t('table.resizer_tooltip') }}">
            <thead>
                <tr class="header-row">
                    <th data-col-key="root_name" data-elastic="true" data-default-pct="32" data-min-width="60" style="text-align: left;">{{ t('index.header.name') }}</th>
                    <th data-col-key="root_snapshots" data-ignore-content="true" data-default-pct="18" data-min-width="120" style="text-align: center;">{{ t('table.snapshots') }}</th>
                    <th data-col-key="root_path" data-default-pct="25" data-min-width="60" style="text-align: left;">{{ t('index.header.mount_point') }}</th>
                    <th data-col-key="sub_path" data-default-pct="25" data-min-width="60" style="text-align: left;">{{ t('index.header.sub_path') }}</th>
                </tr>
            </thead>
            <tbody>
                {% for root in roots %}
                {% if root.is_group_header %}
                <tr class="root-group-row"
                    data-path="{{ root.name }}"
                    data-parent=""
                    data-level="0"
                    data-is-folder="true"
                    data-expanded="true">
                    <td>
                        <div class="tree-cell">
                            <span class="folder-toggle icon opened" title="Toggle group">▶</span>
                            {% if root.group_type == 'zfs' %}
                            <img src="{{ static_url('img/logos/zfs.svg') }}" class="fs-logo" alt="ZFS">
                            {% elif root.group_type == 'btrfs' %}
                            <img src="{{ static_url('img/logos/btrfs.svg') }}" class="fs-logo" alt="Btrfs">
                            {% else %}
                            {{ lucide('folder-cog', size=16, class_='text-muted') }}
                            {% endif %}
                            <span class="group-title">{{ root.display_name }}</span>
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <span class="badge badge-group-total" title="{{ t('table.snapshots') }}">
                            {{ root.snapshots_count }}
                        </span>
                    </td>
                    <td><span class="text-muted">–</span></td>
                    <td><span class="text-muted">–</span></td>
                </tr>
                {% elif root.is_mounted %}
                <tr data-href="{{ route_url('list', root.name, '', 'Original') }}"
                    data-path="{{ root.name }}"
                    data-parent="{{ root.parent_name or '' }}"
                    data-level="{{ root.level }}"
                    data-is-folder="{{ 'true' if root.has_children else 'false' }}"
                    data-expanded="true">
                    <td>
                        <div class="tree-cell" style="padding-left: {{ root.level * 20 }}px;">
                            {% if root.has_children %}
                            <span class="folder-toggle icon opened" title="Toggle hierarchy">▶</span>
                            {% else %}
                            <span class="folder-spacer"></span>
                            {% endif %}
                            {% if root.group_type == 'zfs' %}
                            <img src="{{ static_url('img/logos/zfs.svg') }}" class="fs-logo" alt="ZFS">
                            {% elif root.group_type == 'btrfs' %}
                            <img src="{{ static_url('img/logos/btrfs.svg') }}" class="fs-logo" alt="Btrfs">
                            {% else %}
                            {{ lucide('hard-drive', size=16, class_='text-muted') }}
                            {% endif %}
                            <a class="root-link" href="{{ route_url('list', root.name, '', 'Original') }}" title="{{ root.name }}">
                                {{ root.display_name }}
                            </a>
                        </div>
                    </td>
                    <td style="text-align: center;">
                        <span class="badge" style="background: var(--bg-header-alt); border: 1px solid var(--border-color); color: var(--text-main);">
                            {{ root.snapshots_count }}
                        </span>
                    </td>
                    <td><code>{{ root.root_path }}</code></td>
                    <td><code>{{ root.sub_path or '/' }}</code></td>
                </tr>
                {% else %}
                <tr class="row-unmounted"
                    data-path="{{ root.name }}"
                    data-parent="{{ root.parent_name or '' }}"
                    data-level="{{ root.level }}"
                    data-is-folder="{{ 'true' if root.has_children else 'false' }}"
                    data-expanded="true"
                    style="opacity: 0.65;">
                    <td>
                        <div class="tree-cell" style="padding-left: {{ root.level * 20 }}px;">
                            {% if root.has_children %}
                            <span class="folder-toggle icon opened" title="Toggle hierarchy">▶</span>
                            {% else %}
                            <span class="folder-spacer"></span>
                            {% endif %}
                            {% if root.group_type == 'zfs' %}
                            <img src="{{ static_url('img/logos/zfs.svg') }}" class="fs-logo" alt="ZFS" style="opacity: 0.5;">
                            {% elif root.group_type == 'btrfs' %}
                            <img src="{{ static_url('img/logos/btrfs.svg') }}" class="fs-logo" alt="Btrfs" style="opacity: 0.5;">
                            {% else %}
                            {{ lucide('hard-drive', size=16, class_='text-muted') }}
                            {% endif %}
                            <span class="root-link" style="cursor: not-allowed; text-decoration: none; color: var(--text-muted);" title="{{ root.name }}">
                                {{ root.display_name }}
                                <span class="badge badge-missing" style="font-size: 7.5pt; margin-left: 6px; padding: 1px 6px;">{{ t('badge.unmounted') }}</span>
                            </span>
                        </div>
                    </td>
                    <td style="text-align: center; color: var(--text-muted);">–</td>
                    <td><code style="color: var(--text-muted);">{{ root.root_path }}</code></td>
                    <td><code style="color: var(--text-muted);">{{ root.sub_path or '/' }}</code></td>
                </tr>
                {% endif %}
                {% else %}
                <tr>
                    <td colspan="4" style="text-align: center; padding: 20px; color: var(--text-muted);">
                        {{ t('index.no_roots') }}
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</body>
</html>
