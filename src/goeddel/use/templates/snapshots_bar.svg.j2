{%- macro snapshots_bar(entry, base_url, module, root_name, folder) -%}
{%- set snapshots_bar = entry.snapshots_bar | default([]) | list -%}
{%- set bar = namespace(x=0, height=20, width=20) %}
<svg class="snapshotbar{{ ' is-sub-dataset' if entry.is_sub_dataset else '' }}" viewBox="-1 -1 {{ (snapshots_bar | length) * bar.width + 2 }} {{ bar.height + 1 }}" preserveAspectRatio="none" style="width: 100%; max-width: {{ (snapshots_bar | length) * bar.width }}px; height: 100%;">
    {%- for bar_part in snapshots_bar %}
        {%- if bar_part.missing %}
            <rect x="{{ bar.x + 0.5 }}" y="1" width="19" height="18" rx="2" ry="2" fill="{{ bar_part.color }}" stroke="rgba(0,0,0,0.25)" stroke-width="1"/>
            <line x1="{{ bar.x + 3 }}" y1="3.5" x2="{{ bar.x + 16.5 }}" y2="16.5" stroke="#ef4444" stroke-width="1.5"/>
            <line x1="{{ bar.x + 16.5 }}" y1="3.5" x2="{{ bar.x + 3 }}" y2="16.5" stroke="#ef4444" stroke-width="1.5"/>
        {%- else %}
            <rect x="{{ bar.x + 0.5 }}" y="1" width="19" height="18" rx="2" ry="2" fill="{{ bar_part.color }}" stroke="rgba(0,0,0,0.12)" stroke-width="1"/>
        {%- endif -%}
        {%- if not entry.is_sub_dataset and bar_part.snapshot == entry.snapshot %}
            <circle cx="{{ bar.x + bar.width / 2 }}" cy="{{ bar.height / 2 }}" r="4" fill="#ffffff" stroke="#1e293b" stroke-width="1.5">
            </circle>
        {%- endif %}
    {%- set bar.x = bar.x + bar.width -%}
    {%- endfor -%}
</svg>
{% endmacro %}

{%- macro snapshots_bar_skeleton(snapshots_count) -%}
{%- set bar_width = 20 -%}
{%- set count = snapshots_count | default(10) -%}
{%- if count < 1 -%}{%- set count = 10 -%}{%- endif -%}
<svg class="snapshotbar snapshot-skeleton-svg" viewBox="-1 -1 {{ count * bar_width + 2 }} 21" preserveAspectRatio="none" style="width: 100%; max-width: {{ count * bar_width }}px; height: 100%;">
    {%- for i in range(count) %}
    <rect x="{{ i * bar_width }}" width="19" height="20" rx="2" ry="2" class="skeleton-rect" style="animation-delay: {{ (i * 0.04) | round(2) }}s;"/>
    {%- endfor %}
</svg>
{%- endmacro -%}