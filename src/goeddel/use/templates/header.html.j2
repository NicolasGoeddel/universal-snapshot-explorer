{% from 'assets.html.j2' import stylesheet, script with context %}
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ t('page.title') }}</title>
<link rel="icon" href="/favicon.ico" type="image/svg+xml">
{{ head_preloads | default('') }}
<script>
    (function() {
        try {
            var theme = localStorage.getItem('theme');
            document.documentElement.setAttribute('data-theme-choice', theme || 'system');
            if (theme === 'dark' || (!theme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
                document.documentElement.setAttribute('data-theme', 'dark');
            } else {
                document.documentElement.setAttribute('data-theme', 'light');
            }
        } catch (e) {}
        try {
            window.clientI18n = {{ client_i18n | safe | default("{}") }};
        } catch (e) {
            window.clientI18n = {};
        }
    })();
</script>
{{ stylesheet('css/main.css') }}
{{ stylesheet('css/path_bar.css') }}
{{ stylesheet('css/table_resizer.css') }}
{{ stylesheet('css/typeahead.css') }}
{{ stylesheet('css/selection.css') }}
{{ stylesheet('css/filter.css') }}
<script src="{{ static_url('js/theme.js') }}" defer></script>
<script src="{{ static_url('js/path_bar.js') }}" defer></script>
{{ script('js/table_resizer.js') }}
<script src="{{ static_url('js/tree_table.js') }}" defer></script>
{{ script('js/table_sort_order.js') }}
<script src="{{ static_url('js/table_sorter.js') }}" defer></script>
<script src="{{ static_url('js/filter_manager.js') }}" defer></script>
<script src="{{ static_url('js/selection_manager.js') }}" defer></script>
<script src="{{ static_url('js/keyboard_nav.js') }}" defer></script>
<script src="{{ static_url('js/typeahead.js') }}" defer></script>
