{% from 'snapshots_bar.svg.j2' import render_snapshot_bar %}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
    {% include 'header.html.j2' %}
</head>
<body class="error-page-wrapper">
    <header class="error-page-topbar">
        <a href="{{ base_url }}/" class="root-link" style="font-size: 1.1rem; font-weight: 700; text-decoration: none; color: var(--text-main);">
            {{ lucide('hard-drive', size=20) }} Universal Snapshot Explorer
        </a>
        <div class="nav-controls" style="display: flex; align-items: center; gap: 8px;">
            <!-- Language Dropdown -->
            <div class="dropdown">
                <div class="breadcrumb" style="cursor: pointer;">
                    {{ lucide('globe', size=14) }} <span style="margin-left: 4px;">{{ t('lang.' ~ lang) }}</span>
                </div>
                <div class="dropdown-content">
                    <a href="/set-language/de">{{ t('lang.de') }}</a>
                    <a href="/set-language/en">{{ t('lang.en') }}</a>
                </div>
            </div>

            <!-- Theme Dropdown -->
            <div class="dropdown">
                <div class="breadcrumb" id="theme-selector" style="cursor: pointer;">
                    <span id="theme-icon">{{ lucide('sun', size=14) }}</span> <span style="margin-left: 4px;">Theme</span>
                </div>
                <div class="dropdown-content">
                    <a href="#" onclick="setTheme('light'); return false;">{{ lucide('sun', size=14) }} <span style="margin-left: 4px;">{{ t('theme.light') }}</span></a>
                    <a href="#" onclick="setTheme('dark'); return false;">{{ lucide('moon', size=14) }} <span style="margin-left: 4px;">{{ t('theme.dark') }}</span></a>
                    <a href="#" onclick="setTheme('system'); return false;">{{ lucide('monitor', size=14) }} <span style="margin-left: 4px;">{{ t('theme.system') }}</span></a>
                </div>
            </div>
        </div>
    </header>

    <main class="error-content-container">
        <div class="error-card">
            <div class="error-icon-box">
                {{ lucide('folder-x' if is_folder_error else ('search-x' if status_code == 404 else 'triangle-alert'), size=32) }}
            </div>

            <h1>{{ title | default(t('error.404_title')) }}</h1>
            <p class="error-message">{{ message }}</p>

            {% if path or (snapshot and snapshot.name) %}
            <div class="error-meta-box">
                {% if root_name %}
                <div class="error-meta-item">
                    <span class="error-meta-label">Root:</span>
                    <span class="error-meta-val">{{ root_name }}</span>
                </div>
                {% endif %}
                {% if path %}
                <div class="error-meta-item">
                    <span class="error-meta-label">{{ t('error.requested_path') }}:</span>
                    <span class="error-meta-val">{{ path }}</span>
                </div>
                {% endif %}
                {% if snapshot and snapshot.name %}
                <div class="error-meta-item">
                    <span class="error-meta-label">{{ t('error.active_snapshot') }}:</span>
                    <span class="error-meta-val">{{ snapshot.name }}</span>
                </div>
                {% endif %}
            </div>
            {% endif %}

            {% if nearest_parent %}
            <div class="error-suggestions-section">
                <a href="{{ route_url('list', root_name, nearest_parent.path, snapshot.id if snapshot else 'Original') }}" class="error-btn primary">
                    {{ lucide('corner-left-up', size=18) }} {{ t('error.nearest_parent') }}: {{ nearest_parent.display_path }}
                </a>
            </div>
            {% endif %}

            {% if snapshots_bar and snapshots_bar | length > 0 %}
            <div class="error-suggestions-section">
                <h4 class="error-suggestions-title" style="display: flex; align-items: center; gap: 6px;">
                    {{ lucide('history', size=15) }} {{ t('error.snapshot_timeline') }}
                </h4>
                <div class="error-timeline-wrapper">
                    <div class="snapshots-header-timeline error-timeline-bar">
                        {{ render_snapshot_bar(snapshots_bar, current_snapshot_id=snapshot.id if snapshot else 'Original', is_header=false, with_links=true, root_name=root_name, path=path, module='list') }}
                    </div>
                </div>
            </div>
            {% endif %}

            <div class="error-actions-group" style="margin-top: 24px;">
                {% if root_name %}
                <a href="{{ route_url('list', root_name, '', snapshot.id if snapshot else 'Original') }}" class="error-btn secondary">
                    {{ lucide('folder', size=16) }} {{ t('error.go_to_root_folder') }}
                </a>
                {% endif %}
                <a href="{{ base_url }}/" class="error-btn secondary">
                    {{ lucide('hard-drive', size=16) }} {{ t('error.go_to_roots_overview') }}
                </a>
            </div>
        </div>
    </main>
</body>
</html>
