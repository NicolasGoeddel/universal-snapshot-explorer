<nav class="breadcrumbs pathbar">
    <!-- Home button to Root Overview; its chevron lists the configured roots (shares) -->
    <span class="path-seg">
        <a href="{{ base_url }}/#{{ root_name | quote_plus }}" class="pathbar-item path-crumb home" title="Roots Overview">
            {{ lucide('server', size=16, class_='pathbar-icon') }}<span>{{ t('breadcrumb.root') }}</span>
        </a>
        <button type="button" class="path-chevron" data-menu-template="path-menu-roots" aria-haspopup="menu" aria-expanded="false" title="{{ t('breadcrumb.roots_tooltip') }}">
            {{ lucide('chevron-right', size=14) }}
        </button>
    </span>

    <!-- Share root: stands in for the "/" folder, so its chevron lists the share's top-level folders.
         Kept outside the editable path, which is relative to it. -->
    {% set share_crumb = breadcrumbs.paths[0] %}
    {% set path_crumbs = breadcrumbs.paths[1:] %}
    <span class="path-seg">
        <a href="{{ route_url('list', root_name, share_crumb.path, breadcrumbs.snapshot.id) }}{{ ('#' ~ (path_crumbs[0].name | quote_plus)) if path_crumbs else '' }}" class="pathbar-item path-crumb root{% if share_crumb.is_current %} current{% endif %}" title="{{ breadcrumbs.root.name }}">
            {{ lucide('hard-drive', size=16, class_='pathbar-icon') }}<span>{{ breadcrumbs.root.name }}</span>
        </a>
        {% if share_crumb.separator | default(true) %}
        <button type="button" class="path-chevron" aria-haspopup="menu" aria-expanded="false" title="{{ t('breadcrumb.subfolders_tooltip') }}">
            {{ lucide('chevron-right', size=14) }}
        </button>
        {% endif %}
    </span>

    <!-- Path breadcrumbs dual-mode container -->
    <div class="breadcrumbs-path-container" id="breadcrumbs-path-container"{% if module not in ['detail', 'diff'] %} title="{{ t('breadcrumb.edit_path_tooltip') }}"{% endif %}>
        <div class="breadcrumbs-path-view" id="breadcrumbs-path-view">
            {% for crumb in path_crumbs %}
                <span class="path-seg">
                {% if module in ['detail', 'diff'] and crumb.is_current and not file.is_folder %}
                    <span class="pathbar-item path-crumb current" title="{{ crumb.name }}">
                        {{ lucide('file', size=15, class_='pathbar-icon') }}<span>{{ crumb.name }}</span>
                    </span>
                {% else %}
                    {% set next_crumb = path_crumbs[loop.index] if loop.index < path_crumbs | length else none %}
                    {% set crumb_hash = ('#' ~ (next_crumb.name | quote_plus)) if next_crumb else '' %}
                    <a href="{{ route_url('list', root_name, crumb.path, breadcrumbs.snapshot.id) }}{{ crumb_hash }}" class="pathbar-item path-crumb{% if crumb.is_current %} current{% endif %}" title="{{ crumb.name }}">
                        {% if crumb.is_boundary and crumb.icon_name %}
                            {{ lucide(crumb.icon_name, size=15, class_='file-icon ' ~ crumb.icon_class) }}<span>{{ crumb.name }}</span>
                        {% elif module in ['detail', 'diff'] and crumb.is_current and file.is_folder %}
                            {{ lucide('folder', size=15, class_='pathbar-icon') }}<span>{{ crumb.name }}</span>
                        {% else %}
                            <span>{{ crumb.name }}</span>
                        {% endif %}
                    </a>
                {% endif %}
                {% if crumb.separator | default(true) %}
                    {#- Windows-Explorer-style chevron: opens a menu of this folder's subfolders (static/js/path_bar.js) -#}
                    <button type="button" class="path-chevron" aria-haspopup="menu" aria-expanded="false" title="{{ t('breadcrumb.subfolders_tooltip') }}">
                        {{ lucide('chevron-right', size=14) }}
                    </button>
                {% endif %}
                </span>
            {% endfor %}
        </div>
        {% if module not in ['detail', 'diff'] %}
        <div class="breadcrumbs-path-edit" id="breadcrumbs-path-edit" style="display: none;">
            {{ lucide('folder-open', size=15, class_='pathbar-icon') }}
            <input type="text" id="breadcrumb-path-input" class="breadcrumb-path-input" value="{{ breadcrumbs.current_path }}" placeholder="{{ t('breadcrumb.path_placeholder') }}" data-root="{{ root_name }}" data-snapshot="{{ breadcrumbs.snapshot.id }}">
        </div>
        {#- Only visible while the path leaves enough free room for it (pure CSS, see path_bar.css) -#}
        <span class="path-edit-hint-slot" aria-hidden="true"><span class="path-edit-hint"><kbd>Ctrl</kbd><kbd>L</kbd></span></span>
        {% endif %}
    </div>

    <div class="pathbar-actions">
        <!-- Snapshot indicator / dropdown; lights up (.in-past) while a past snapshot is shown -->
        {% if module == 'detail' %}
            <span class="pathbar-item snapshot static{% if not breadcrumbs.snapshot.is_original %} in-past{% endif %}" title="{{ t('table.snapshot') }}">
                {{ lucide('calendar', size=16, class_='pathbar-icon') }}
                <span id="breadcrumb-snapshot-name">{{ breadcrumbs.snapshot.name }}</span>
                {% if breadcrumbs.snapshot.has_timestamp %}
                    <span class="breadcrumb-snapshot-time">{{ breadcrumbs.snapshot.timestamp_formatted }}</span>
                {% endif %}
            </span>
        {% elif module != 'diff' %}
            <div class="pathbar-item snapshot dropdown{% if not breadcrumbs.snapshot.is_original %} in-past{% endif %}" id="breadcrumb-snapshot-dropdown">
                {{ lucide('calendar', size=16, class_='pathbar-icon') }}<span id="breadcrumb-snapshot-name">{{ breadcrumbs.snapshot.name }}</span>{{ lucide('chevron-down', size=13, class_='pathbar-caret') }}
                <div class="dropdown-content snapshot-dropdown-content">
                    <div class="snapshot-dropdown-header">
                        <span class="snapshot-header-time">{{ t('table.timestamp') }}</span>
                        <span class="snapshot-header-name">{{ t('table.snapshot') }}</span>
                    </div>
                    {% for snapshot in breadcrumbs.snapshots %}
                        <a href="{{ route_url('list', root_name, breadcrumbs.current_path, snapshot.id) }}"
                           data-snap-id="{{ snapshot.id }}"
                           class="snapshot-dropdown-item {% if snapshot.id == breadcrumbs.snapshot.id %}active{% endif %}">
                            <span class="snapshot-item-time">
                                {% if snapshot.is_original %}
                                    <span class="badge-live">{{ t('badge.live') }}</span>
                                {% elif snapshot.has_timestamp %}
                                    {{ snapshot.timestamp_formatted }}
                                {% else %}
                                    –
                                {% endif %}
                            </span>
                            <span class="snapshot-item-name" title="{{ snapshot.name }}">{{ snapshot.name }}</span>
                        </a>
                    {% endfor %}
                </div>
            </div>
        {% endif %}
        {% include 'nav_controls.html.j2' %}
    </div>

    <template id="path-menu-folder-icon">{{ lucide('folder', size=15) }}</template>
    {#- Static menu for the home chevron: every configured root, opened on its live snapshot -#}
    <template id="path-menu-roots">
        {%- for r_name in breadcrumbs.all_roots %}
        <a class="path-menu-item is-root{% if r_name == root_name %} active{% endif %}" role="menuitem" href="{{ route_url('list', r_name, '', 'Original') }}" title="{{ r_name }}">{{ lucide('hard-drive', size=15) }}<span>{{ r_name }}</span></a>
        {%- endfor %}
    </template>
</nav>
